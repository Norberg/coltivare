{
  "name": "odlingskartan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "node scripts/local-tool.mjs vite --host 0.0.0.0",
    "build": "node scripts/local-tool.mjs tsc --noEmit && node scripts/local-tool.mjs vite build",
    "typecheck": "node scripts/local-tool.mjs tsc --noEmit",
    "lint": "node scripts/local-tool.mjs eslint src tests",
    "test": "node scripts/local-tool.mjs jest --runInBand",
    "test:cloud-sql": "node scripts/test-cloud-sql.mjs",
    "test:e2e": "node scripts/local-tool.mjs playwright test",
    "test:install": "node scripts/local-tool.mjs playwright install chromium",
    "preview": "node scripts/local-tool.mjs vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.66.0",
    "bootstrap": "^5.3.0",
    "idb": "^8.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.3.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0"
  }
